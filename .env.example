# Local development works without this file. Copy to .env only if your shell loads it.
SECRET_KEY=change-me-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
TIME_ZONE=Asia/Kolkata
STATIC_ROOT=
MEDIA_ROOT=
LOG_PATH=

# Leave EMAIL_BACKEND as console locally. For Gmail use an App Password, not your normal password.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production SMTP example (set these in the deployment environment, never commit real values):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=notifications@your-college.edu
# EMAIL_HOST_PASSWORD=your-provider-app-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@example.com
INSTITUTE_NAME=Your College or Institute
EXAM_DUTY_DEPARTMENT=Department of Computer Science & Engineering
# Optional fixed examination title / official reference printed on duty orders
EXAM_DUTY_EXAMINATION_NAME=
EXAM_DUTY_REFERENCE=
EXAM_DUTY_DEFAULT_NOTE=All faculty members and PhD scholars are requested to report to their allotted rooms before the commencement of the examination.

# Required only when build.sh must create the first Render administrator.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
SEED_DEMO_DATA=False
